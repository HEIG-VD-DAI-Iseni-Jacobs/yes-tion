FULLY_QUALIFIED_DOMAIN_NAME = arthurjacobs.duckdns.org

# The email address for Let's Encrypt
TRAEFIK_ACME_EMAIL=arthur.jacobs@heig-vd.ch

# The fully qualified domain name to access Traefik
TRAEFIK_FULLY_QUALIFIED_DOMAIN_NAME=traefik.${FULLY_QUALIFIED_DOMAIN_NAME}

# Enable the Traefik dashboard
TRAEFIK_ENABLE_DASHBOARD=true

# The image version to use for Traefik
TRAEFIK_IMAGE_VERSION=latest

# The fully qualified domain name to access Yes-tion
YESTION_FULLY_QUALIFIED_DOMAIN_NAME=yes-tion.${FULLY_QUALIFIED_DOMAIN_NAME}

# The fully qualified domain name to access whoami
WHOAMI_FULLY_QUALIFIED_DOMAIN_NAME=whoami1.${FULLY_QUALIFIED_DOMAIN_NAME}

# The image version to use for whoami
WHOAMI_IMAGE_VERSION=latest